# The Node range in package.json's engines field is enforced, not advisory:
# an install on an unsupported major stops with one clear line instead of
# failing later inside Vite or the tsx import hook.
engine-strict=true

# Skip the advisory lookup on install: it POSTs the whole tree to the
# registry's audit endpoint, and when that endpoint is slow or returns 5xx
# npm retries it in silence for up to 15 minutes before continuing.
# start-tutto-prod.bat ran into exactly that. Run `npm audit` on purpose instead.
audit=false
