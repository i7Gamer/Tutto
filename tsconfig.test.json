{
  /* The suites themselves, which nothing type-checks.
     tsconfig.app.json and tsconfig.server.json both EXCLUDE every test file,
     vitest transpiles without checking, and the ESLint block for tests sets no
     parserOptions.project — so a signature change leaves its callers in the
     tests wrong and the whole pipeline stays green until something happens to
     assert on the value at runtime.

     A CI GATE since 2026-09-02 (ci.yml runs `npm run type-check:test` right
     after the production type-check), and deliberately still not referenced
     from tsconfig.json: tsc --build would otherwise type-check the suites on
     every editor save of a production file. It went from 1486 errors to zero
     through typed fixture factories (src/testing/factories.ts and the helpers
     socketTestHarness.ts exports) — a full Player/CoreGameState/ServerPlayer
     instead of a partial literal, a real Response instead of a hand-rolled
     one, nonNull() where a test dereferences a nullable read. Keep it that
     way: a new error here is a fixture that lies about a shape.

     Left at full `strict` on purpose: relaxing it to make the number smaller
     buys nothing while neither number is green, and quietly moves the
     destination. */
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    /* `preserve` for the same reason tsconfig.server.json uses it: these files
       span both halves of the repo, and the server half is loaded by tsx. */
    "module": "preserve",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "jsx": "react-jsx",
    "moduleDetection": "force",

    "strict": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    /* The ambient declarations the app config picks up from "include": ["src"]
       -- import.meta.env and window.__TEST_MODE__ live here, and without them
       the count below would be inflated by config artefacts. */
    "src/vite-env.d.ts",
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.integration.test.tsx",
    "server/**/*.test.ts",
    "server/**/*.integration.test.ts",
    "e2e/**/*.ts",
    "vite.config.ts",
    "vite.config.test.ts",
    "playwright.config.ts"
  ],
  "exclude": ["server/node_modules"]
}
