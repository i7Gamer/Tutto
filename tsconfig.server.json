{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    /* tsx loads these, so resolution is a bundler's job — and it has to be:
       server/*.ts share src/utils/*, whose extensionless relative imports
       node16/nodenext would reject. `preserve` keeps both import and require
       available, which the CommonJS runtime needs. */
    "module": "preserve",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "noEmit": true,

    /* JSON imports */
    "resolveJsonModule": true,

    /* Interop */
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    /* Strictness */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["server/**/*.ts"],
  "exclude": ["server/**/*.test.ts", "server/**/*.integration.test.ts", "server/node_modules"]
}
