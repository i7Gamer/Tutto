{
  "name": "tutto",
  "private": true,
  "version": "1.6.6",
  "engines": {
    "node": ">=22 <25"
  },
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "postinstall": "cd server && npm install",
    "dev": "vite",
    "server": "tsx server/index.ts",
    "start": "concurrently \"npm run server\" \"npm run dev\"",
    "start:prod": "npm run build && cross-env NODE_ENV=production node --import tsx server/index.ts",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:publish-cleanup": "bash scripts/test-publish-cleanup/run.sh",
    "type-check": "tsc --build",
    "type-check:test": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "chart.js": "^4.6.1",
    "framer-motion": "^14.10.0",
    "i18next": "^26.7.2",
    "immer": "^11.2.9",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.70.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.13",
    "socket.io-client": "^4.8.4",
    "uuid": "^14.0.3",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.62.0",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^5.1.0",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jest-canvas-mock": "^2.5.2",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.0",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "shell-quote": "^1.11.0",
    "minimatch": "^11.0.4",
    "filelist": "^2.0.2",
    "glob": "^14.0.3"
  }
}
