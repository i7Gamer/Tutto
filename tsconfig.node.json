{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "noEmit": true,

    /* eslint.config.js and the repo-local lint rules stay plain JS (flat
       config and custom rules are JS-first in the ESLint ecosystem); allowJs
       keeps them in the program without type-checking them. */
    "allowJs": true,
    "checkJs": false,

    /* Strictness */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": [
    "vite.config.ts",
    "vite.config.test.ts",
    "eslint.config.js",
    "playwright.config.ts",
    "e2e/**/*.ts"
  ]
}
