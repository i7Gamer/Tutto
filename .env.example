# ─── Frontend (Vite) ─────────────────────────────────────────────────────────
# Token sent by the browser when writing to the stats API.
# Must match TUTTO_API_TOKEN on the server.
VITE_API_TOKEN=tutto-local-dev-token

# ─── Backend (Node / Express) ────────────────────────────────────────────────
# Secret token required in the X-Tutto-Token header for protected POST routes.
# Set a strong random value in production (e.g. openssl rand -hex 32).
TUTTO_API_TOKEN=tutto-local-dev-token

# Port the Express server listens on (default: 3001).
PORT=3001

# NOTE: NODE_ENV is NOT set here — this file is loaded by Vite, which sets
# NODE_ENV itself based on the build mode. For the Node server, NODE_ENV must
# be set in the shell. Use `npm run start:prod` which sets it automatically.
