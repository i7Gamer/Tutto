# Keeps the build context small and, more importantly, keeps secrets and
# test-only code out of the image. server/packaging.test.ts asserts that no
# test helper is reachable from production code; this file is what stops them
# being copied in the first place.

# VCS and tooling
.git
.gitignore
.github
.claude
.vscode
.idea

# Dev-only scripts (e.g. icon generation) — never referenced by the Dockerfile
scripts/

# Dependencies — reinstalled inside the image from the lockfiles
node_modules
server/node_modules

# Build output — the builder stage produces its own
dist
dist-ssr
*.tsbuildinfo

# Secrets. Configuration reaches the container as environment variables; a
# baked-in .env would ship an API_TOKEN inside a published image.
.env
.env.*

# Tests, fixtures and reports
coverage
test-results
playwright-report
e2e
playwright.config.ts
# Extension left open rather than enumerated: the .ts/.tsx list here silently
# stopped covering src/sw.test.js, and the bare root pattern is what
# vite.config.test.ts walked past. Docker matches with Go's filepath.Match plus
# `**`, where `*` never crosses a '/', so the root pattern stays at the root.
# Brace alternation is NOT in that grammar — `*.test.{js,ts}` would match a file
# literally named that and nothing else. packaging.test.ts enforces both.
*.test.*
src/**/*.test.*
src/setupTests.tsx
server/**/*.test.*
eslint-rules/**/*.test.*
# Test-only helpers: socketTestHarness spawns child processes, testPorts is the
# suites' port registry, testTimeouts holds their hook budgets. None of them has
# any business in a production image. Mirrored by TEST_ONLY_HELPERS in
# server/packaging.test.ts, which now derives the membership independently.
server/socketTestHarness.ts
server/testPorts.ts
server/testTimeouts.ts

# Databases and their backups — the image starts empty and uses a volume
*.db
*.sqlite
*.backup
*.bak*

# Local scratch and generated caches
scratch
.token-savior-cache.json
*scratchpad*

# Docs and local scripts. COPYING and NOTICE are deliberately NOT ignored —
# the Dockerfile copies them into the image for AGPL compliance.
*.md
*.bat
*.cmd
Dockerfile
.dockerignore
docker-compose.yml
